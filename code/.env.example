# Choose one: dummy, gemini, openai, openai_compatible
LLM_PROVIDER=dummy

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# OpenAI-compatible APIs, e.g. DeepSeek or Groq.
# DeepSeek example:
# OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODEL=deepseek-v4-flash
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# Local no-cost provider via Ollama.
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434

# Evaluation behavior
TEMPERATURE=0
TOP_K=5

# Retrieval backend:
# tfidf = local keyword retrieval, no vector DB required
# chroma = persistent semantic vector store under data/processed/chroma
RETRIEVER_BACKEND=tfidf
