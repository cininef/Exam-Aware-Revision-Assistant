# Copy this file to .env and fill in your provider settings.
# Web UI: bash code/run_web.sh

# --- Pick ONE provider (do not leave as dummy) ---
# dummy | ollama | gemini | openai | openai_compatible
LLM_PROVIDER=dummy

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- OpenAI-compatible (Qwen / DeepSeek / Groq / etc.) ---
# Qwen (DashScope) example:
# LLM_PROVIDER=openai_compatible
# OPENAI_COMPATIBLE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_COMPATIBLE_API_KEY=sk-xxx
# OPENAI_COMPATIBLE_MODEL=qwen-plus
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# --- Local Ollama (brew install ollama && ollama pull qwen2.5:3b) ---
# LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434

TEMPERATURE=0
TOP_K=5
RETRIEVER_BACKEND=tfidf
